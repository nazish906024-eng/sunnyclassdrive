rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schoolFiles/{fileId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 25 * 1024 * 1024
        && request.resource.data.downloadURL is string
        && request.resource.data.storagePath is string;
      allow update: if request.auth != null
        && resource.data.uploadedBy == request.auth.uid
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'originalName'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow delete: if request.auth != null && resource.data.uploadedBy == request.auth.uid;
    }
  }
}
